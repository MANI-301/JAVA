import java.util.Scanner;
class Factorial 
{
	static int fact =1;
	static Scanner sc = new Scanner (System.in);
	public static void main(String[] args)
	{
		System.out.println("Enter Num:");
		int n =sc.nextInt();
		factorial(n);
		System.out.println(fact);
	}
	public static void factorial(int a)
	{
		if (a>0)
		{
			fact*=a--;
		}
	}
}
