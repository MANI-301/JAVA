class ZigZag1
{
	public static void main(String[] args) 
	{
		int []a = {10,20,30,40};
		int[]b = {50,60,70,80};
		int[]res = solve(a,b); 
		System.out.println(Arrays.toString(s));
	}
	public static int[] solve(int[]a,int[]b)
	{
		int[]c= new int[a.length+b.length];
		for (int i=0,j=0,k=b.length-1;i<c.length;i++)
		{
			if (i%2==1)
			{
				c[j]=a[j++];
			}
			else if (i%2==0)
			{
				c[j]=b[k--]
			}
		}
		return c;
	}
}
