import java.util.*;
class ArrayCopy  
{
	public static void main(String[] args) 
	{
		int[]a = {1,2,3,4,5};
		System.out.println(Arrays.toString(a));
		int [] res = solve(a);
		System.out.println(Arrays.toString(res));
	}
	public static int[] solve(int a)
	{
		int [] b = new int[a.length];
		for (int i=0;i<a.length;i++)
		{
			b[i] = a[i];
		}
		return b;
	}
}
