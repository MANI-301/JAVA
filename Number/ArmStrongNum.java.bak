import java.util.*;
class ArmStrongNum 
{
	static Scanner sc = new Scanner (System.in);
	public static void main(String[] args)
	{
		System.out.println("Enter Num:");
		int n =sc.nextInt();
		int temp = n;
		int sum=0,num=0;
		while (n>0)
		{
			num+=n%10;
			sum+=num*num*num;
			n/=10;
		}
		if (sum==temp)
		{
			System.out.println("ArmStrong");
		}
		else 
			System.out.println("Not Armtrong");
	}
}
