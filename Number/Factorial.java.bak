import java.util.*;
class Factorial 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.println("Enter any number:");
		int n = sc.nextInt();
		int fact = 0;
		for (int i=1;i<=n;i++ )
		{
			fact*=i;
		}
		System.out.println(fact);
	}
}
