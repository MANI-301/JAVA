import java.util.*;
class FibonacciSeries 
{
	static Scanner sc = new Scanner (System.in);
	public static void main(String[] args) 
	{
		System.out.println("Enter num");
		int n = sc.nextInt();
		int a=0,b=1,c=0;
		System.out.print(a+"");
		System.out.print(b+"");
		
		for (int i=0;i<=n;i++)
		{
			c=a+b;
			a=b;
			b=c;
			System.out.print(c+"");	
		}
	}
}
