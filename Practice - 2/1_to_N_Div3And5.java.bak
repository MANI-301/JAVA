import java.util.Scanner;
class 1_to_N_Div3And5
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter Any Number:");
		int n = sc.nextInt();
		int number = 1;
		while (number<=n)
		{
			System.out.println(number+":It is Odd");
			number/2;
			number/5
			
		}
		
		}
	}
