import java.util.Scanner;
class Sum_Of_N_natural_numbers 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.println("Enter No:");
		int n = sc.nextInt();
		int sum = 0;
		for (int i=0;i<=n;i++)
		{
		  sum = sum+i;
		}
			System.out.println("natural number is " +sum );
	}
}
