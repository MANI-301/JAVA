import java.util.Scanner;
class N_to_1 
{
	static Scanner sc = new Scanner(System.in);
	public static void main(String[] args) 
	{
		System.out.print("Enter Any Number:");
		int n = sc.nextInt();
		int number = 1;
		while (number<=n)
		{
			System.out.println(n+"");
			n--;
		}
		{
		}
	}
}
